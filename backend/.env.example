# Copy to .env and fill in real values.
# .env is git-ignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (zero-setup, file lives at backend/cor1x.db).
# Swap for Postgres when you're ready for production:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cor1x
DATABASE_URL=sqlite+aiosqlite:///./cor1x.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── GSTIN search (Masters India) ─────────────────────────────────────────────
# Dashboard: https://mastersindia.co   Docs: https://docs.mastersindia.co/gst-verification-api/
# Fallback: canned dev response (Kaveri Foods, Maharashtra).
MASTERS_INDIA_ACCESS_TOKEN=

# ─── OTP / SMS (MSG91) ────────────────────────────────────────────────────────
# Dashboard: https://control.msg91.com   Docs: https://docs.msg91.com/otp
# Fallback: verify accepts 123456 in dev.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ─── Admin console ────────────────────────────────────────────────────────────
# Generate ADMIN_PASSWORD_HASH with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpass', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=admin@cor1x.local
ADMIN_PASSWORD_HASH=
# 40+ char random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=

# ─── User session cookies ─────────────────────────────────────────────────────
# Signs cor1x_session (24h) + cor1x_verified_phone (10 min) cookies.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# When false, cookies get Secure=true (HTTPS only) and rate limits are strict.
# Relaxes rate limits (dev/testing). Set false for real production.
DEBUG=true

# Set true on ANY HTTPS deploy where the frontend and backend are different
# sites (e.g. two *.up.railway.app subdomains) so auth cookies are issued as
# SameSite=None; Secure and flow cross-site. Leave false for http://localhost.
# Independent of DEBUG — a testing env can keep DEBUG=true AND set this true.
CROSS_SITE_COOKIES=false
