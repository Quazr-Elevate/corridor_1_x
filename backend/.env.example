# Copy to .env and fill in real values. .env is git-ignored.
# Every relative path below is resolved against backend/ (not the cwd).

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: SQLite file at backend/cor1x.db (create it with
#   backend/.venv/bin/python backend/scripts/init_local_db.py).
# Production: Postgres. postgres:// and postgresql:// URLs are coerced to the
# asyncpg driver automatically.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cor1x
DATABASE_URL=sqlite+aiosqlite:///./cor1x.db
# Postgres: cancel any statement running longer than this (ms). 0 = no limit.
DB_STATEMENT_TIMEOUT_MS=15000

# ─── Web ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public frontend URL used in email links / redirects (default: first CORS origin).
FRONTEND_BASE_URL=

# true  → relaxed rate limits (x RATE_LIMIT_DEBUG_MULTIPLIER) and the signup
#         code response includes devCode.
# false → production. ALWAYS false on a real deployment.
DEBUG=true

# true on ANY HTTPS deploy where frontend and backend are different sites
# (e.g. two *.up.railway.app subdomains) → cookies are SameSite=None; Secure.
# Leave false for http://localhost. Independent of DEBUG.
CROSS_SITE_COOKIES=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# kv (key=value lines) | json (one JSON object per line)
LOG_FORMAT=kv

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Signs the cor1x_session cookie and keys the email-code hashes. REQUIRED in prod.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Admin console (single operator). Generate the hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpass', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=admin@cor1x.local
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_HOURS=12

# ─── Email (app/integrations/email) ───────────────────────────────────────────
# console → prints + writes .eml files to EMAIL_OUTBOX_DIR (no credentials)
# resend  → https://resend.com (EMAIL_FROM must be a verified-domain sender)
# brevo   → https://brevo.com
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@cor1x.local
EMAIL_FROM_NAME=Cor1x
EMAIL_REPLY_TO=
EMAIL_OUTBOX_DIR=outbox
# Total tries on transient failures (network / 429 / 5xx), exponential backoff.
EMAIL_MAX_ATTEMPTS=3
EMAIL_TIMEOUT_SEC=10

# ─── SMS (app/integrations/sms) — not wired to any endpoint yet ────────────────
# console → logs + writes to SMS_OUTBOX_DIR, keeps OTPs in memory
# msg91   → https://control.msg91.com (OTP API + Flow API for transactional SMS)
SMS_PROVIDER=console
SMS_OUTBOX_DIR=outbox/sms
SMS_DEFAULT_COUNTRY_CODE=91
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRY_MINUTES=10
SMS_MSG91_AUTH_KEY=
SMS_MSG91_OTP_TEMPLATE_ID=
SMS_MSG91_FLOW_TEMPLATE_ID=
# Template variable that receives the message text in the Flow API.
SMS_MSG91_FLOW_VAR_NAME=message

# ─── Storage (app/integrations/storage) ───────────────────────────────────────
# local → files under STORAGE_DIR. On Railway mount a volume and point this at
#         it (e.g. /data/uploads) — the container filesystem is ephemeral.
# s3    → skeleton only (S3 / Cloudflare R2), not implemented yet.
STORAGE_BACKEND=local
STORAGE_DIR=uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ─── Rate limiting (app/ratelimit) ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# memory (per process). A Redis backend can implement the same interface.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
# Limits are multiplied by this when DEBUG=true (still enforced).
RATE_LIMIT_DEBUG_MULTIPLIER=10
# Number of proxies in front of the API. The client IP is read that many
# entries from the RIGHT of X-Forwarded-For (clients can only forge the left
# side). 0 = ignore the header (local dev). Railway edge → API = 1;
# Railway edge → frontend /api proxy → API = 2.
RATE_LIMIT_TRUSTED_PROXIES=0

# ─── Exchange rates (app/integrations/fx) ─────────────────────────────────────
# Daily USD-based rates for multi-currency prices (listing prices are never
# changed; price_usd is for filters/conversions). Requests only read the DB.
# true → the API process refreshes on start when today's rates are missing,
#        then every FX_REFRESH_HOURS (one asyncio task per process). With
#        several workers set false and cron scripts/refresh_rates.py instead.
FX_ENABLED=true
# Tried in order per currency: frankfurter | fawazahmed0 | static (offline/tests)
FX_PROVIDERS=frankfurter,fawazahmed0
# Listing + display currencies (must match ck_users_display_currency).
FX_SUPPORTED_CURRENCIES=INR,AED,USD
FX_REFRESH_HOURS=24
FX_TIMEOUT_SEC=10
FX_MAX_ATTEMPTS=3
# Reject a fetched rate that moves more than this % vs the last stored one.
FX_MAX_CHANGE_PCT=20

# ─── Lookups (pincode / IFSC) ─────────────────────────────────────────────────
# true → canned responses, no network (offline dev only). false in prod: an
# upstream outage returns 502 and the UI asks for city/state manually.
LOOKUPS_STUB=false
