{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cor1x-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "cor1x-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "cor1x-backend-mac",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "cor1x-tracker",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4100",
        "--directory",
        "docs/tracker"
      ],
      "port": 4100
    }
  ]
}
