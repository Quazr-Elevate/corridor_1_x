{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cor1x-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "cor1x-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "backend", "app.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
