# Copy to .env.local and adjust for your setup.
# .env.local is git-ignored.

# Base URL of the FastAPI backend.
# Default: http://localhost:8000 (local uvicorn dev server).
# In production, point at your deployed API host.
# Host only: the /v1 version prefix is added by lib/apiBase.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
